# Firebase Web configuration. These identifiers are intentionally browser-visible
# in a web/mobile client. Restrict the Firebase Web API key and enforce Firestore
# Security Rules; do not treat these values as server secrets.
VITE_FIREBASE_API_KEY=replace-with-restricted-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=optional-measurement-id

# Never add Google Translate, DeepL, iyzico, service-account, webhook, or other
# private provider credentials here. Put them in Cloud Secret Manager (or an
# equivalent server-side secret store) for Firebase Functions/Cloud Run instead.
