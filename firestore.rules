rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Privileged book, plan, and identity mutations run through Cloud
    // Functions with the Admin SDK. Browser clients never receive direct
    // administrative write access, including clients with an admin claim.
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Reserved for server-side authorization. No client write rule relies on
    // this claim; the Admin SDK bypasses these rules in trusted Functions.
    function hasAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'email', 'name', 'avatarUrl', 'languagePreference', 'role',
          'streak', 'xp', 'dailyGoal', 'lastVisitDate', 'subscriptionStatus',
          'plan', 'trialEndsAt', 'subscriptionEndsAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'USER'
        && request.resource.data.streak == 0
        && request.resource.data.xp == 0
        && request.resource.data.subscriptionStatus == 'ACTIVE'
        && request.resource.data.plan == 'FREE'
        && request.resource.data.trialEndsAt == 0
        && request.resource.data.subscriptionEndsAt == 0;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'avatarUrl', 'languagePreference', 'dailyGoal', 'updatedAt'
        ]);
      allow delete: if false;

      match /vocabulary/{wordId} {
        allow read: if owns(uid);
        // Clients can save/edit word content, but review scheduling is written
        // only by trusted callable Functions using the Admin SDK.
        allow create: if owns(uid)
          && (!('strength' in request.resource.data) || request.resource.data.strength == 0)
          && !('repetitions' in request.resource.data)
          && !('intervalDays' in request.resource.data)
          && !('easeFactor' in request.resource.data)
          && !('correctCount' in request.resource.data)
          && !('wrongCount' in request.resource.data)
          && !('lastReviewedAt' in request.resource.data)
          && !('nextReviewAt' in request.resource.data);
        allow update: if owns(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'word', 'translation', 'definition', 'exampleSentence', 'type',
            'level', 'sourceBookId', 'sourceChapterId', 'normalizedWord',
            'createdAt', 'updatedAt', 'nextReviewDate', 'id'
          ]);
        allow delete: if owns(uid);
      }

      match /progress/{bookId} {
        allow read, write: if owns(uid);
      }

      match /reviewEvents/{eventId} {
        allow read: if owns(uid);
        allow write: if false;
      }
      match /xpEvents/{eventId} { allow read: if owns(uid); allow write: if false; }
      match /learningSummary/{summaryId} { allow read: if owns(uid); allow write: if false; }

      // Only trusted migration tooling may mark a compatibility copy complete.
      match /migrationState/{stateId} {
        allow read: if owns(uid);
        allow write: if false;
      }
    }

    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if false;

      match /chapters/{chapterId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Prepared language data is produced exclusively by trusted Functions.
      // Readers may consume it in a later phase but can never mutate it.
      match /languageChapters/{chapterId} {
        allow read: if signedIn();
        allow write: if false;

        match /sentences/{sentenceId} {
          allow read: if signedIn();
          allow write: if false;
        }

        match /tokenChunks/{chunkId} {
          allow read: if signedIn();
          allow write: if false;
        }
      }
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Imports contain unreviewed source material and are exclusively managed
    // by trusted callable Functions. An admin browser token is not a bypass.
    match /bookImports/{importId} {
      allow read, write: if false;
    }

    // Current client documents are keyed by the Firebase Auth UID. A later
    // data-model migration may move these to user subcollections.
    match /vocabulary/{uid} {
      allow read, write: if owns(uid);
    }

    match /progress/{uid} {
      allow read, write: if owns(uid);
    }

    // The browser may consume centrally managed dictionary cache entries, but
    // never publish global cache data as an authoritative client writer.
    match /dictionary_cache/{entryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /dictionary/{entryId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      // Subscription records are canonically keyed by the Firebase Auth UID.
      // Requiring both identifiers avoids exposing a malformed duplicate record.
      allow read: if owns(subscriptionId) && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
