{
  "name": "readlex-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:compatibility": "vitest run tests/compatibility.test.ts",
    "test:rules": "firebase emulators:exec --project demo-readlex-tests --only firestore \"node --test tests/rules.test.mjs\"",
    "test:migrations": "npm --prefix functions run build && firebase emulators:exec --project demo-readlex-tests --only firestore \"node --test tests/migrations.test.mjs\"",
    "test:emulator": "npm run test:rules && npm run test:migrations",
    "test": "npm run test:compatibility && npm run test:emulator"
  },
  "dependencies": {
    "@google/genai": "latest",
    "firebase": "^10.8.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "firebase-tools": "^15.32.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
